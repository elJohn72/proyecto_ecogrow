# Plantilla de variables de entorno para EcoGrow en VPS kv2
# Copiar a .env en el VPS y rellenar con secretos reales generados.
# NUNCA subir el .env a Git ni compartir secretos en chats.

ECOGROW_DOMAIN=ecogrow.prueba.local
SECRET_KEY=PRUEBA_generar_con_openssl_rand_hex_32
MYSQL_ROOT_PASSWORD=PRUEBA_generar_password_root_robusto
MYSQL_DATABASE=ecogrow_db
MYSQL_USER=ecogrow_user
MYSQL_PASSWORD=PRUEBA_generar_password_user_robusto
ECOGROW_SENSOR_API_TOKEN=PRUEBA_generar_token_esp32_robusto
ECOGROW_ADMIN_EMAILS=admin@ecogrow.prueba.local
